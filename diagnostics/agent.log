{"step": 8, "tool": "llm_code", "args": {"attempt": 1}, "result": "import numpy as np\nimport pandas as pd\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.svm import SVC\nfrom sklearn.pipeline import Pipeline\nimport json\n\n# Read the data\ndata_path = 'raisin.csv'\ndf = pd.read_csv(data_path)\n\n# Extract features and target\nX = df[['Area', 'MajorAxisLength', 'MinorAxisLength', 'Eccentricity', 'ConvexArea', 'Extent', 'Perimeter']]\ny = df['Class']\n\n# Extract fold count\nn_folds = 10\n\n# Initialize StratifiedKFold\nskf = StratifiedKFold(n_splits=n_folds, shuffle=True, random_state=42)\n\n# Prepare output list for predictions\npredictions = []\ntotal_correct = 0\ntotal = 0\n\n# Iterate over folds\nfor fold_idx, (train_idx, test_idx) in enumerate(skf.split(X, y), 1):\n    # Split data\n    X_train, X_test = X.iloc[train_idx], X.iloc[test_idx]\n    y_train, y_test = y.iloc[train_idx], y.iloc[test_idx]\n    \n    # Train a fresh pipeline for each fold\n    pipeline = Pipeline([\n        ('scaler', StandardScaler()),\n        ('svc', SVC(kernel=\"poly\", C=1.0, degree=3, gamma=\"scale\", coef0=0.0))\n    ])\n    \n    # Fit on training data only\n    pipeline.fit(X_train, y_train)\n    \n    # Predict on test set\n    y_pred = pipeline.predict(X_test)\n    \n    # Calculate accuracy for this fold\n    correct_count = np.sum(y_pred == y_test.values)\n    total_correct += correct_count\n    total += len(y_test)\n    \n    # Store predictions with row_id and fold\n    test_df = df.iloc[test_idx][['row_id']].reset_index(drop=True)\n    test_df['fold'] = fold_idx\n    test_df['prediction'] = y_pred\n    \n    predictions.extend(test_df[['row_id', 'fold', 'prediction']].values)\n\n# Save predictions to CSV\npredictions_df = pd.DataFrame(predictions)\npredictions_df.to_csv('predictions.csv', index=False)\n\n# Final metric\naccuracy = total_correct / total\nprint(\"METRIC\", json.dumps({\"accuracy\": accuracy}))"}
